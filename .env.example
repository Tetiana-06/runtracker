# =====================================================================
# RUNTRACKER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Safe for Git repository commit - contains NO real secrets or tokens
# =====================================================================
# Instructions:
# 1. Copy this template to '.env' in your local development environment:
#    cp .env.example .env
# 2. Set actual credentials in your local '.env' file (which is git-ignored).
# =====================================================================

# API access token for RunTracker internal services
RUNTRACKER_API_KEY=your_synthetic_api_key_here

# Runtime environment (development | staging | production)
RUNTRACKER_ENV=development

# Logging verbosity (DEBUG | INFO | WARNING | ERROR)
RUNTRACKER_LOG_LEVEL=INFO
